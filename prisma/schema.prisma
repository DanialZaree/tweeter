generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Tweet {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tweetId   String?   @unique
  authorId  String    @db.ObjectId
  content   String
  createdAt DateTime  @default(now()) @map("createdAt")
  viewCount Int       @default(0)
  isEdited  Boolean   @default(false)
  mediaUrl  String?

  parentId  String?   @db.ObjectId
  parent    Tweet?    @relation("TweetReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Tweet[]   @relation("TweetReplies")

  ancestorIds  String[]  @db.ObjectId
  totalReplies Int       @default(0)

  retweetOfId          String?   @db.ObjectId
  retweetOf            Tweet?    @relation("TweetRetweets", fields: [retweetOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  retweets             Tweet[]   @relation("TweetRetweets")
  originalTweetDeleted Boolean   @default(false)

  notifications Notification[]
  author        User      @relation(fields: [authorId], references: [id])
  likes         Like[]
}


model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userName      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  name          String?
  job           String?
  avatar        String?
  image         String?
  coverImage    String?
  bio           String?
  createdAt     DateTime  @default(now()) @map("createdAt")
  updatedAt     DateTime? @updatedAt
  tweets        Tweet[]
  likes         Like[]
  accounts      Account[]
  sessions      Session[]

  followers  Follower[] @relation("UserFollowers")
  following  Follower[] @relation("UserFollowing")

  notificationsReceived Notification[] @relation("RecipientNotifications")
  notificationsSent     Notification[] @relation("SenderNotifications")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Like {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tweetId   String    @db.ObjectId

  user      User      @relation(fields: [userId], references: [id])
  tweet     Tweet     @relation(fields: [tweetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, tweetId])
}

model Follower {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  followerId  String   @db.ObjectId

  user        User     @relation("UserFollowing", fields: [userId], references: [id])
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id])

  @@unique([userId, followerId])
}

model Verification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier  String
  token       String
  expires     DateTime

  @@unique([identifier, token])
}


enum NotificationType {
  LIKE
  REPLY
  RETWEET
  FOLLOW
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  recipientId String           @db.ObjectId
  senderId    String           @db.ObjectId 
  type        NotificationType
  tweetId     String?          @db.ObjectId 
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient   User             @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender      User             @relation("SenderNotifications", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tweet       Tweet?           @relation(fields: [tweetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
}
